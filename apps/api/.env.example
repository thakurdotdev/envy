# Copy this file to apps/api/.env for local development.
# These values only work on your own machine. Never reuse them in production.
APP_ENV=development
PORT=3000
DATABASE_URL=postgres://appuser:appuser@localhost:5432/envy
API_URL=http://localhost:3000
WEB_URL=http://localhost:3001
# At least 32 random characters, for example: openssl rand -base64 48
JWT_SECRET=
# From a GitHub OAuth app with "Enable Device Flow" ticked.
# Callback URL: http://localhost:3000/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# How many proxies in front of the API append to X-Forwarded-For: 0 for none,
# 1 for nginx (also behind Cloudflare when nginx restores the visitor's
# address, see docs/deploy.md). ("true" means 1, "false" 0.)
TRUST_PROXY=0
