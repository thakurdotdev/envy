{
  "name": "@envy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/envy-api",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@envy/tsconfig": "workspace:*",
    "drizzle-kit": "0.31.11"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.32",
    "postgres": "3.4.9"
  }
}
