# A comment on its own line

PLAIN=hello
  INDENTED=yes
export EXPORTED=from-shell
SPACED = around the equals sign   
EMPTY=
EMPTY_QUOTED=""
URL_WITH_HASH=https://example.invalid/page#section
INLINE_COMMENT=value # this part is a comment
DOUBLE="a \"quoted\" word\tand a tab\\n is literal backslash-n"
SINGLE='no $expansion or \n escapes here'
BACKTICK=`it's "both" quotes`
QUOTED_WITH_COMMENT="kept" # comment after quotes
MULTILINE_DOUBLE="first line
  second line, indented
third line"
MULTILINE_SINGLE='-----BEGIN KEY-----
abc123
-----END KEY-----'
ESCAPED_NEWLINES="one\ntwo"
TRAILING_SPACES_IN_QUOTES="  padded  "
UNICODE=żółw 🐢
DUPLICATE=first
DUPLICATE=second
dotted.name-with-dash=ok
CRLF_SAFE=yes
